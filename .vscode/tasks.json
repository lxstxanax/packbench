{
    "version": "2.0.0",

    // There is NO workspace-wide "options.cwd" here, on purpose.
    //
    // This workspace holds TWO firmware projects that flash the same kind of
    // board over the same ST-Link. A single "Flash" button that inherited a
    // workspace cwd programmed whichever project that cwd happened to point
    // at -- which meant pressing Flash with the car attached could put the
    // standalone bench monitor onto the car. Every task below therefore names
    // its own project directory and its own .elf, and every task that touches
    // the target says "car" or "monitor" in its label.
    //
    //   car      car_fw/         build/Debug/motor_uart_pwm_nucleo.elf
    //                            motor + servo + Raspberry Pi link + pack monitor
    //   monitor  max17320_gui/   build/Debug/max17320_gui.elf
    //                            standalone bench monitor, no motor
    //
    // Tasks with no project in the label touch no firmware image: they reset
    // or erase the attached MCU, run host tests, or open a serial view.

    "tasks": [
        /* ---------------------------------------------------------------- *
         * car  --  car_fw/  ->  motor_uart_pwm_nucleo.elf
         * ---------------------------------------------------------------- */
        {
            "label": "Build car",
            "type": "shell",
            "command": "cmake --preset Debug && cmake --build --preset Debug",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": false,
                    "color": "#22d63a",
                    "detail": "car_fw -> motor_uart_pwm_nucleo.elf"
                }
            }
        },
        {
            "label": "Clean car",
            "type": "shell",
            "command": "cmake --build --preset Debug --target clean",
            "problemMatcher": [],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": true,
                    "color": "#e91f11"
                }
            }
        },
        {
            "label": "Clean & Rebuild car",
            "type": "shell",
            "command": "cmake --preset Debug && cmake --build --preset Debug --clean-first",
            "problemMatcher": "$gcc",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": false,
                    "color": "#e9e507",
                    "detail": "car_fw: full rebuild (re-emits the steering-calibration #warning)"
                }
            }
        },
        {
            "label": "Size car",
            "type": "shell",
            "command": "arm-none-eabi-size",
            "args": ["./build/Debug/motor_uart_pwm_nucleo.elf"],
            "group": "build",
            "dependsOn": ["Build car"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            },
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": true,
                    "color": "#0cec2a",
                    "filePattern": ""
                }
            }
        },
        {
            "label": "Flash car",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-c", "program build/Debug/motor_uart_pwm_nucleo.elf verify reset exit"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "dependsOn": ["Clean & Rebuild car", "Size car"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": false,
                    "color": "#13e6e6",
                    "detail": "CAR: clean rebuild, size, then program motor_uart_pwm_nucleo.elf",
                    "icon": {
                        "id": "play"
                    }
                }
            }
        },
        {
            "label": "Erase & Flash car",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-c", "program build/Debug/motor_uart_pwm_nucleo.elf verify reset exit"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "dependsOn": ["Full CHIP Erase", "Build car", "Size car"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": false,
                    "color": "#d8e613",
                    "detail": "CAR: full chip erase, build, then program motor_uart_pwm_nucleo.elf",
                    "icon": {
                        "id": "gear"
                    }
                }
            }
        },
        {
            "label": "CubeMX car",
            "type": "shell",
            "command": "stm32cubemx",
            "args": ["./motor_uart_pwm_nucleo.ioc"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            },
            "options": {
                "cwd": "${workspaceFolder}/car_fw",
                "statusbar": {
                    "hide": true,
                    "color": "#13e6e6",
                    "filePattern": "",
                    "icon": {
                        "id": "gear"
                    }
                }
            }
        },

        /* ---------------------------------------------------------------- *
         * monitor  --  max17320_gui/  ->  max17320_gui.elf
         * ---------------------------------------------------------------- */
        {
            "label": "Build monitor",
            "type": "shell",
            "command": "cmake --preset Debug && cmake --build --preset Debug",
            "problemMatcher": "$gcc",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": false,
                    "color": "#22d63a",
                    "detail": "max17320_gui -> max17320_gui.elf (bench monitor, no motor)"
                }
            }
        },
        {
            "label": "Clean monitor",
            "type": "shell",
            "command": "cmake --build --preset Debug --target clean",
            "problemMatcher": [],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": true,
                    "color": "#e91f11"
                }
            }
        },
        {
            "label": "Clean & Rebuild monitor",
            "type": "shell",
            "command": "cmake --preset Debug && cmake --build --preset Debug --clean-first",
            "problemMatcher": "$gcc",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": true,
                    "color": "#e9e507"
                }
            }
        },
        {
            "label": "Size monitor",
            "type": "shell",
            "command": "arm-none-eabi-size",
            "args": ["./build/Debug/max17320_gui.elf"],
            "group": "build",
            "dependsOn": ["Build monitor"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            },
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": true,
                    "color": "#0cec2a",
                    "filePattern": ""
                }
            }
        },
        {
            "label": "Flash monitor",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-c", "program build/Debug/max17320_gui.elf verify reset exit"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "dependsOn": ["Clean & Rebuild monitor", "Size monitor"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": false,
                    "color": "#13e6e6",
                    "detail": "MONITOR: clean rebuild, size, then program max17320_gui.elf (bench board only)",
                    "icon": {
                        "id": "play"
                    }
                }
            }
        },
        {
            "label": "Erase & Flash monitor",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-c", "program build/Debug/max17320_gui.elf verify reset exit"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "dependsOn": ["Full CHIP Erase", "Build monitor", "Size monitor"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": true,
                    "color": "#d8e613",
                    "detail": "MONITOR: full chip erase, build, then program max17320_gui.elf",
                    "icon": {
                        "id": "gear"
                    }
                }
            }
        },
        {
            "label": "CubeMX monitor",
            "type": "shell",
            "command": "stm32cubemx",
            "args": ["./max17320_gui.ioc"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            },
            "options": {
                "cwd": "${workspaceFolder}/max17320_gui",
                "statusbar": {
                    "hide": true,
                    "color": "#13e6e6",
                    "filePattern": "",
                    "icon": {
                        "id": "gear"
                    }
                }
            }
        },

        /* ---------------------------------------------------------------- *
         * board-level and host tasks -- no firmware image involved
         * ---------------------------------------------------------------- */
        {
            "label": "Reset",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-c", "init; reset run; exit"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false,
                    "color": "#13e6e6",
                    "detail": "Reset whichever MCU is attached (no programming)",
                    "icon": {
                        "id": "refresh"
                    }
                }
            }
        },
        {
            "label": "Full CHIP Erase",
            "type": "shell",
            "command": "st-flash",
            "args": ["erase"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false,
                    "color": "#f53404",
                    "detail": "Erase the entire chip on the attached board -- leaves it with NO firmware",
                    "icon": {
                        "id": "trash"
                    }
                }
            }
        },
        {
            "label": "Test Decode (host)",
            "type": "shell",
            "command": "gcc -std=c11 -Wall -Wextra -I. -Itest -o /tmp/test_decode test/test_decode.c max17320.c max17320_monitor.c && /tmp/test_decode",
            "group": "test",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}/fw",
                "statusbar": {
                    "hide": false,
                    "color": "#22d63a",
                    "detail": "Run the register-decoding tests on the PC (no board needed)",
                    "icon": {
                        "id": "beaker"
                    }
                }
            }
        },
        {
            "label": "Serial Monitor (ST-Link VCP)",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/serial_monitor.sh"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "statusbar": {
                    "hide": false,
                    "color": "#9b59b6",
                    "detail": "Live 115200 view of the pack-monitor console on the ST-Link VCP (both projects use it)",
                    "icon": {
                        "id": "output"
                    }
                }
            }
        },
        {
            "label": "BMS Dashboard",
            "type": "shell",
            "command": "${workspaceFolder}/tools/bms_dashboard/run.sh",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "statusbar": {
                    "hide": false,
                    "color": "#f39c12",
                    "detail": "Open the live BMS dashboard (close the Serial Monitor first - the port is exclusive)",
                    "icon": {
                        "id": "pulse"
                    }
                }
            }
        },
        {
            "label": "Post Debug Task",
            "type": "shell",
            "command": "echo 'Debug session ended.'",
            "problemMatcher": [],
            "presentation": {
                "clear": true
            },
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        }
    ]
}
